{
  "name": "markdown-ai-editor",
  "displayName": "Markdown AI Editor",
  "description": "Private, local Markdown and plain-text editing with a lightweight on-device AI model.",
  "version": "0.0.2",
  "publisher": "AmarpreetBhatia",
  "license": "SEE LICENSE IN LICENSE",
  "pricing": "Free",
  "repository": {
    "type": "git",
    "url": "https://github.com/amarpreetbhatia/markdown-ai-editor-.git"
  },
  "bugs": {
    "url": "https://github.com/amarpreetbhatia/markdown-ai-editor-/issues"
  },
  "homepage": "https://amarpreetbhatia.github.io/markdown-ai-editor-/",
  "categories": [
    "Formatters",
    "Machine Learning"
  ],
  "keywords": ["markdown", "writing", "grammar", "local ai", "offline", "privacy"],
  "icon": "media/icon.png",
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "onCommand:markdownAi.fixGrammar",
    "onCommand:markdownAi.formatNotes",
    "onLanguage:markdown",
    "onLanguage:plaintext"
  ],
  "contributes": {
    "commands": [
      {
        "command": "markdownAi.fixGrammar",
        "title": "Markdown AI: Fix Grammar & Refine"
      },
      {
        "command": "markdownAi.formatNotes",
        "title": "Markdown AI: Convert to Clean Markdown"
      },
      {
        "command": "markdownAi.showLocalModelStatus",
        "title": "Markdown AI: Show Local Model Status"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "markdownAi.fixGrammar",
          "when": "editorHasSelection && (resourceLangId == markdown || resourceLangId == plaintext)",
          "group": "1_modification@1"
        },
        {
          "command": "markdownAi.formatNotes",
          "when": "editorHasSelection && (resourceLangId == markdown || resourceLangId == plaintext)",
          "group": "1_modification@2"
        }
      ]
    },
    "configuration": {
      "title": "Markdown AI Editor",
      "properties": {
        "markdownAi.useManagedEngine": {
          "type": "boolean",
          "default": true,
          "description": "Download and run a local English writing assistant after you approve its first-use download (about 271 MB). It works offline after setup, preserves Markdown where possible, and may make mistakes."
        },
        "markdownAi.customApiBaseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8080/v1",
          "description": "Custom endpoint URL if 'useManagedEngine' is set to false."
        },
        "markdownAi.model": {
          "type": "string",
          "default": "SmolLM2-360M-Instruct-Q4_K_M",
          "description": "Model name passed in API requests."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  }
}
